# ==============================================================================
# BEE4 Storefront & Enterprise Admin Suite — Environment Variables
# ==============================================================================

# Supabase Free Plan Client Configuration (VITE_SUPABASE_*)
# Copy your Project URL and anon public key from Supabase Dashboard -> Settings -> API
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Authorized Admin Email for /admin Supabase Auth RBAC (matches VITE_ADMIN_EMAIL or is_admin=true)
VITE_ADMIN_EMAIL="ranjitbgm@gmail.com"
VITE_ADMIN_ALLOWED_EMAILS="ranjitbgm@gmail.com"

# Optional SHA-256 hex digest to customize the fallback local Studio Passphrase Gate
# VITE_ADMIN_PASSWORD_HASH=""

# GEMINI_API_KEY: Required if server-side AI features are enabled
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Deployed public base URL for sitemaps, SEO canonicals, and invoices
APP_URL="MY_APP_URL"

# Optional live Email + Invoice delivery (choose SMTP/Gmail OR Resend)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"
# SMTP_USER=""
# SMTP_PASS=""
# EMAIL_FROM="BEE4 Store <hello@bee4.in>"
# RESEND_API_KEY=""

# Optional live SMS order confirmation delivery (choose Twilio OR Fast2SMS)
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM_NUMBER=""
# FAST2SMS_API_KEY=""
