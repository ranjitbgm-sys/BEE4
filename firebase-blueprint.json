{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Catalog product item available on the BEE4 storefront.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique product identifier.",
          "minLength": 2,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "description": "Display title of the product.",
          "minLength": 2,
          "maxLength": 140
        },
        "category": {
          "type": "string",
          "description": "Brain skill category.",
          "enum": [
            "Engineering",
            "Maths & Science",
            "Motor Skills",
            "Imagination"
          ]
        },
        "ageGroup": {
          "type": "string",
          "description": "Child developmental age group.",
          "enum": [
            "3–5 Years",
            "6–8 Years",
            "9–11 Years",
            "12–15 Years"
          ]
        },
        "originConcept": {
          "type": "string",
          "description": "East-Asian origin design badge.",
          "maxLength": 120
        },
        "occasion": {
          "type": "string",
          "description": "Primary gifting occasion.",
          "enum": [
            "Birthday",
            "Festivals & Diwali",
            "Housewarming",
            "Desk & College",
            "Everyday Use"
          ]
        },
        "price": {
          "type": "number",
          "description": "Selling price in INR."
        },
        "compareAtPrice": {
          "type": "number",
          "description": "Original MRP in INR for discount display."
        },
        "image": {
          "type": "string",
          "description": "Product image path or HTTPS URL.",
          "minLength": 1,
          "maxLength": 1000
        },
        "variants": {
          "type": "array",
          "description": "Bounded list of selectable product variants (max 10)."
        },
        "shortSpec": {
          "type": "string",
          "description": "Single-line product specification summary.",
          "minLength": 2,
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "description": "Full product description.",
          "minLength": 2,
          "maxLength": 2000
        },
        "useCaseHi": {
          "type": "string",
          "description": "How to play / mechanism explanation in Hindi.",
          "maxLength": 1000
        },
        "brainBenefitsHi": {
          "type": "string",
          "description": "Scientific cognitive benefits for the child age group in Hindi.",
          "maxLength": 1000
        },
        "whyParentsBuyHi": {
          "type": "string",
          "description": "Persuasive screen-free value for Indian parents in Hindi.",
          "maxLength": 1000
        },
        "materials": {
          "type": "string",
          "description": "Craftsmanship and materials specification.",
          "minLength": 1,
          "maxLength": 300
        },
        "dimensions": {
          "type": "string",
          "description": "Dimensions or capacity specification.",
          "minLength": 1,
          "maxLength": 200
        },
        "inStock": {
          "type": "boolean",
          "description": "Whether the product is available for purchase."
        },
        "featured": {
          "type": "boolean",
          "description": "Whether the product appears in storefront featured picks."
        },
        "tag": {
          "type": "string",
          "description": "Optional short merchandising label.",
          "maxLength": 40
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when product was last updated."
        }
      },
      "required": [
        "id",
        "title",
        "category",
        "ageGroup",
        "occasion",
        "price",
        "image",
        "variants",
        "shortSpec",
        "description",
        "materials",
        "dimensions",
        "inStock"
      ]
    },
    "StoreSettings": {
      "title": "StoreSettings",
      "description": "Publicly readable store configuration managed by store administrators.",
      "type": "object",
      "properties": {
        "whatsappNumber": {
          "type": "string",
          "description": "Storefront WhatsApp concierge phone number.",
          "minLength": 10,
          "maxLength": 20
        },
        "supportEmail": {
          "type": "string",
          "format": "email",
          "description": "Customer support email address.",
          "minLength": 5,
          "maxLength": 120
        },
        "announcementText": {
          "type": "string",
          "description": "Top announcement bar text.",
          "minLength": 1,
          "maxLength": 200
        },
        "freeShippingThreshold": {
          "type": "number",
          "description": "Order subtotal in INR required for free pan-India delivery."
        },
        "promoCode": {
          "type": "string",
          "description": "Active promo code.",
          "maxLength": 32
        },
        "promoDiscountPercent": {
          "type": "number",
          "description": "Percentage discount applied for the active promo code."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when settings were updated."
        }
      },
      "required": [
        "whatsappNumber",
        "supportEmail",
        "announcementText",
        "freeShippingThreshold",
        "promoCode",
        "promoDiscountPercent"
      ]
    },
    "UserPublic": {
      "title": "UserPublic",
      "description": "Non-PII root account record anchoring private customer subcollections.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID.",
          "minLength": 6,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Customer display name.",
          "minLength": 1,
          "maxLength": 100
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": ["uid", "displayName", "createdAt", "updatedAt"]
    },
    "UserPrivateProfile": {
      "title": "UserPrivateProfile",
      "description": "Isolated PII and preferences document stored at /users/{userId}/private/info.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID.",
          "minLength": 6,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fullName": {
          "type": "string",
          "description": "Customer full name.",
          "minLength": 1,
          "maxLength": 100
        },
        "phone": {
          "type": "string",
          "description": "Customer 10-digit Indian phone number (optional until provided).",
          "maxLength": 20
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Customer email address.",
          "maxLength": 160
        },
        "preferredPayment": {
          "type": "string",
          "description": "Preferred checkout payment method.",
          "enum": ["upi", "card", "cod"]
        },
        "celebrationMonth": {
          "type": "string",
          "description": "Optional preferred celebration month.",
          "maxLength": 40
        },
        "wishlistIds": {
          "type": "array",
          "description": "Bounded list of saved product IDs (max 50)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": ["uid", "fullName", "preferredPayment", "wishlistIds", "createdAt", "updatedAt"]
    },
    "SavedAddress": {
      "title": "SavedAddress",
      "description": "Customer saved delivery address inside /users/{userId}/addresses/{addressId}.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique address document ID.",
          "minLength": 2,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID.",
          "minLength": 6,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "label": {
          "type": "string",
          "description": "Address label.",
          "enum": ["Home", "Work", "Other"]
        },
        "fullName": {
          "type": "string",
          "description": "Recipient full name.",
          "minLength": 2,
          "maxLength": 100
        },
        "phone": {
          "type": "string",
          "description": "10-digit Indian mobile number.",
          "minLength": 10,
          "maxLength": 15
        },
        "address": {
          "type": "string",
          "description": "Street and building delivery address.",
          "minLength": 5,
          "maxLength": 300
        },
        "city": {
          "type": "string",
          "description": "City name.",
          "minLength": 2,
          "maxLength": 80
        },
        "state": {
          "type": "string",
          "description": "Indian state or UT.",
          "minLength": 2,
          "maxLength": 80
        },
        "pinCode": {
          "type": "string",
          "description": "6-digit Indian PIN code.",
          "pattern": "^[1-9][0-9]{5}$",
          "minLength": 6,
          "maxLength": 6
        },
        "isDefault": {
          "type": "boolean",
          "description": "Whether this is the default checkout address."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "id",
        "userId",
        "label",
        "fullName",
        "phone",
        "address",
        "city",
        "state",
        "pinCode",
        "isDefault",
        "createdAt",
        "updatedAt"
      ]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order summary document stored at /orders/{orderNumber}.",
      "type": "object",
      "properties": {
        "orderNumber": {
          "type": "string",
          "description": "Unique order number.",
          "minLength": 4,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID.",
          "minLength": 6,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "subtotal": { "type": "number", "description": "Order subtotal in INR." },
        "discount": { "type": "number", "description": "Promo discount in INR." },
        "shippingFee": { "type": "number", "description": "Delivery fee in INR." },
        "giftWrapFee": { "type": "number", "description": "Gift wrap fee in INR." },
        "total": { "type": "number", "description": "Final payable total in INR." },
        "paymentMethod": {
          "type": "string",
          "enum": ["upi", "card", "cod"],
          "description": "Selected payment method."
        },
        "customerFullName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "customerPhone": { "type": "string", "minLength": 10, "maxLength": 15 },
        "customerEmail": { "type": "string", "maxLength": 160 },
        "shippingAddress": { "type": "string", "minLength": 5, "maxLength": 300 },
        "shippingCity": { "type": "string", "minLength": 2, "maxLength": 80 },
        "shippingState": { "type": "string", "minLength": 2, "maxLength": 80 },
        "shippingPinCode": {
          "type": "string",
          "pattern": "^[1-9][0-9]{5}$",
          "minLength": 6,
          "maxLength": 6
        },
        "giftWrap": { "type": "boolean" },
        "giftMessage": { "type": "string", "maxLength": 300 },
        "itemCount": { "type": "number", "description": "Number of line items in subcollection." },
        "status": {
          "type": "string",
          "enum": ["Confirmed", "Preparing Shipment", "Shipped", "Delivered", "Cancelled"],
          "description": "Fulfillment lifecycle status."
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "orderNumber",
        "userId",
        "subtotal",
        "discount",
        "shippingFee",
        "giftWrapFee",
        "total",
        "paymentMethod",
        "customerFullName",
        "customerPhone",
        "customerEmail",
        "shippingAddress",
        "shippingCity",
        "shippingState",
        "shippingPinCode",
        "giftWrap",
        "giftMessage",
        "itemCount",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "OrderItem": {
      "title": "OrderItem",
      "description": "Individual line item inside /orders/{orderNumber}/items/{itemId}.",
      "type": "object",
      "properties": {
        "orderNumber": {
          "type": "string",
          "minLength": 4,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 6,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "productId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "price": { "type": "number" },
        "image": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "variant": { "type": "string", "minLength": 1, "maxLength": 80 },
        "quantity": { "type": "number" },
        "category": { "type": "string", "minLength": 1, "maxLength": 80 }
      },
      "required": [
        "orderNumber",
        "userId",
        "productId",
        "title",
        "price",
        "image",
        "variant",
        "quantity",
        "category"
      ]
    },
    "Testimonial": {
      "title": "Testimonial",
      "description": "Verified customer review displayed on the storefront.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 2,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 6,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "customerName": { "type": "string", "minLength": 2, "maxLength": 80 },
        "cityOrRole": { "type": "string", "minLength": 2, "maxLength": 80 },
        "productName": { "type": "string", "minLength": 2, "maxLength": 160 },
        "rating": { "type": "number" },
        "feedback": { "type": "string", "minLength": 5, "maxLength": 600 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "userId",
        "customerName",
        "cityOrRole",
        "productName",
        "rating",
        "feedback",
        "createdAt"
      ]
    },
    "CustomerInquiry": {
      "title": "CustomerInquiry",
      "description": "Contact / bulk gifting inquiry submitted to store support.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 2,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 6,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": { "type": "string", "minLength": 2, "maxLength": 100 },
        "contact": { "type": "string", "minLength": 4, "maxLength": 160 },
        "topic": { "type": "string", "minLength": 2, "maxLength": 100 },
        "message": { "type": "string", "minLength": 5, "maxLength": 1500 },
        "status": { "type": "string", "enum": ["New", "Resolved"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "name", "contact", "topic", "message", "status", "createdAt", "updatedAt"]
    },
    "AdminMarker": {
      "title": "AdminMarker",
      "description": "Server-managed role document granting admin permissions when UID matches.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 6,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "createdAt"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Public storefront catalog documents managed by verified admins."
    },
    "/storeSettings/{settingId}": {
      "schema": { "$ref": "#/entities/StoreSettings" },
      "description": "Public storefront settings document (main) managed by verified admins."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserPublic" },
      "description": "Non-PII root user anchor document for ownership verification."
    },
    "/users/{userId}/private/info": {
      "schema": { "$ref": "#/entities/UserPrivateProfile" },
      "description": "Isolated PII profile, preferences, and bounded wishlist for the user."
    },
    "/users/{userId}/addresses/{addressId}": {
      "schema": { "$ref": "#/entities/SavedAddress" },
      "description": "Customer saved delivery addresses subcollection."
    },
    "/orders/{orderNumber}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer orders isolated to owner or store admin."
    },
    "/orders/{orderNumber}/items/{itemId}": {
      "schema": { "$ref": "#/entities/OrderItem" },
      "description": "Normalized order line items subcollection attached atomically on order creation."
    },
    "/testimonials/{testimonialId}": {
      "schema": { "$ref": "#/entities/Testimonial" },
      "description": "Publicly readable verified customer reviews."
    },
    "/inquiries/{inquiryId}": {
      "schema": { "$ref": "#/entities/CustomerInquiry" },
      "description": "Customer support and bulk order inquiries visible only to submitter or admin."
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminMarker" },
      "description": "Admin allowlist documents locked against client writes."
    }
  }
}
